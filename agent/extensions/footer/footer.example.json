{
  "_comment": "Place this file at ~/.pi/agent/configs/footer.json. The compact model and context options below are opt-in: remove segmentOptions.model / compactLabel to restore the default spacing and the `24.3% / 1.0M` context label.",
  "row1LeftSegments": ["pi", "separator", "model", "text:⚡", "thinking", "separator", "path", "git"],
  "row1RightSegments": [],
  "row2LeftSegments": ["context_pct"],
  "row2RightSegments": ["token_total", "separator", "cost"],
  "icons": {
    "pi": "\ue22c",
    "folder": "\uf115",
    "branch": "\uf126",
    "git": "\uf1d3",
    "separator": "|"
  },
  "colors": {
    "model": "#c07898",
    "thinkingHigh": "#afb9fe",
    "thinkingXhigh": "#9575cd",
    "thinkingMax": "#ce93d8",
    "separator": "#87827a"
  },
  "segmentOptions": {
    "path": {
      "mode": "basename"
    },
    "git": {
      "showBranch": true,
      "showStaged": true,
      "showUnstaged": true,
      "showUntracked": true
    },
    "model": {
      "aliasLabels": {
        "implementer-medium": "impl",
        "implementer-high": "impl+",
        "reviewer-medium": "rev",
        "reviewer-high": "rev+",
        "mid-model": "mid",
        "high-model": "high",
        "scout": "scout",
        "planner": "plan",
        "main": "main"
      },
      "compactThinking": true
    },
    "contextBar": {
      "barWidth": 18,
      "filledChar": "▋",
      "unfilledChar": "▋",
      "unfilledColor": "#4e4c49",
      "gradientStart": "#f29373",
      "gradientMid": "#d67858",
      "gradientEnd": "#ae4f2f",
      "gradientMidPoint": 0.55,
      "compactLabel": true
    }
  }
}
